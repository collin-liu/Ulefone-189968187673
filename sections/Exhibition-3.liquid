{%- liquid
  case section.settings.font_family
    when 'body'
      assign font_stack = 'var(--font-body-family, inherit)'
    when 'custom'
      assign font_stack = section.settings.custom_font_family
    else
      assign font_stack = 'var(--font-heading-family, inherit)'
  endcase

  assign col_left = section.settings.left_column_width
  assign col_right = 100 | minus: col_left
  assign cols = 'left,right' | split: ','
-%}

{% style %}
@font-face {
    font-family: BatmanForeverAlternate;
    src: url('https://cdn.shopify.com/s/files/1/0830/0573/5193/files/BatmanForeverAlternate.woff2');
}
  #PSGrid--{{ section.id }} {
    --ps-font: {{ font_stack }};
    --ps-techno: {{ section.settings.techno_font_family }};
    --ps-gap: {{ section.settings.mobile_gap }}px;
    --ps-radius: {{ section.settings.mobile_radius }}px;
    --ps-pad: {{ section.settings.mobile_card_padding }}px;
    --ps-fs-title: {{ section.settings.mobile_card_title_size }}px;
    --ps-fs-sub: {{ section.settings.mobile_card_sub_size }}px;
    --ps-ls-techno: {{ section.settings.techno_letter_spacing | divided_by: 1000.0 }}em;
    --ps-ls-regular: {{ section.settings.regular_letter_spacing | divided_by: 1000.0 }}em;
    --ps-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ps-title-color: {{ section.settings.card_title_color }};
    --ps-sub-color: {{ section.settings.card_sub_color }};

    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_side }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  #PSGrid--{{ section.id }} .ps__inner {
    max-width: 1460px;
    margin-inline: auto;
  }

  /* ---------- 大标题 ---------- */
  #PSGrid--{{ section.id }} .ps__heading {
    margin: 0 0 {{ section.settings.mobile_heading_gap }}px;
    font-family: var(--ps-font);
    font-size: {{ section.settings.mobile_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.25;
    text-align: {{ section.settings.heading_align }};
    color: {{ section.settings.heading_color }};
  }

  /* ---------- 栅格 ---------- */
  #PSGrid--{{ section.id }} .ps__grid {
    display: grid;
    {%- if section.settings.mobile_columns == '1' %}
      grid-template-columns: minmax(0, 1fr);
    {%- else %}
      grid-template-columns: minmax(0, {{ col_left }}fr) minmax(0, {{ col_right }}fr);
    {%- endif %}
    gap: var(--ps-gap);
    align-items: start;
  }

  #PSGrid--{{ section.id }} .ps__col {
    display: flex;
    flex-direction: column;
    gap: var(--ps-gap);
  }

  /* ---------- 卡片 ---------- */
  #PSGrid--{{ section.id }} .ps__card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--ps-ratio, 1.5);
    overflow: hidden;
    border-radius: var(--ps-radius);
    background-color: #111;
    text-decoration: none;
    isolation: isolate;
  }

  #PSGrid--{{ section.id }} .ps__card img,
  #PSGrid--{{ section.id }} .ps__card svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    {%- if section.settings.enable_hover %}
      transition: transform .5s cubic-bezier(.2,.6,.2,1);
    {%- endif %}
  }

  {%- if section.settings.enable_hover %}
    @media (hover: hover) {
      #PSGrid--{{ section.id }} a.ps__card:hover img { transform: scale(1.04); }
    }
  {%- endif %}

  #PSGrid--{{ section.id }} .ps__card::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,var(--ps-overlay)) 0%, rgba(0,0,0,0) 100%);
    pointer-events: none;
  }

  #PSGrid--{{ section.id }} .ps__text {
    position: absolute;
    left: var(--ps-pad);
    right: var(--ps-pad);
    bottom: var(--ps-pad);
    z-index: 2;
  }

  #PSGrid--{{ section.id }} .ps__card-title {
    margin: 0;
    font-size: var(--ps-fs-title);
    font-weight: {{ section.settings.card_title_weight }};
    line-height: 1.2;
    color: var(--ps-title-color);
  }

  #PSGrid--{{ section.id }} .ps__card--techno .ps__card-title {
    font-family: BatmanForeverAlternate;
    letter-spacing: var(--ps-ls-techno);
    text-transform: uppercase;
  }

  #PSGrid--{{ section.id }} .ps__card--regular .ps__card-title {
    font-family: var(--ps-font);
    letter-spacing: var(--ps-ls-regular);
  }

  #PSGrid--{{ section.id }} .ps__card-sub {
    margin: 0.45em 0 0;
    font-size: var(--ps-fs-sub);
    font-weight: 400;
    line-height: 1.35;
    color: var(--ps-sub-color);
  }

  /* ================= PC 端 ================= */
  @media screen and (min-width: 750px) {
    #PSGrid--{{ section.id }} {
      --ps-gap: {{ section.settings.desktop_gap }}px;
      --ps-radius: {{ section.settings.desktop_radius }}px;
      --ps-pad: {{ section.settings.desktop_card_padding }}px;
      --ps-fs-title: {{ section.settings.desktop_card_title_size }}px;
      --ps-fs-sub: {{ section.settings.desktop_card_sub_size }}px;
      padding: {{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_padding_side }}px {{ section.settings.desktop_padding_bottom }}px;
    }

    #PSGrid--{{ section.id }} .ps__heading {
      margin-bottom: {{ section.settings.desktop_heading_gap }}px;
      font-size: {{ section.settings.desktop_heading_size }}px;
    }

    #PSGrid--{{ section.id }} .ps__grid {
      grid-template-columns: minmax(0, {{ col_left }}fr) minmax(0, {{ col_right }}fr);
    }
  }
{% endstyle %}

<div class="ps" id="PSGrid--{{ section.id }}">
  <div class="ps__inner">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="ps__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
    {%- endif -%}

    <div class="ps__grid">
      {%- for col in cols -%}
        <div class="ps__col ps__col--{{ col }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign bcol = block.settings.column | default: 'left'
              assign tag = 'div'
              if block.settings.link != blank
                assign tag = 'a'
              endif
              assign card_alt = block.settings.image_alt | default: block.settings.title | escape
              assign loading = 'lazy'
              if forloop.index0 == 0 and col == 'left'
                assign loading = 'eager'
              endif
            -%}
            {%- if bcol == col -%}
              <{{ tag }}
                class="ps__card ps__card--{{ block.settings.font_style }}"
                style="--ps-ratio: {{ block.settings.ratio | divided_by: 100.0 }};"
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
                {{ block.shopify_attributes }}>

                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: loading,
                      widths: '300,450,600,750,900,1100,1400',
                      sizes: '(min-width: 750px) 45vw, 48vw',
                      alt: card_alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

                {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                  <div class="ps__text">
                    {%- if block.settings.title != blank -%}
                      <h3 class="ps__card-title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <p class="ps__card-sub">{{ block.settings.subtitle | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </{{ tag }}>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

