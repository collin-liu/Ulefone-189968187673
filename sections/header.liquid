<script>
 /**$(function(){

   $(".nav-rows-new li").mouseenter(function(){
     var cur_parent = $(this).parents(".new-mega-menu-container");
     cur_parent.find(".nav-rows-new li").removeClass("active")
     $(this).addClass("active");
     var cur_index = $(this).data("index");
     cur_parent.find(".products-list .tab-content").removeClass("active")
     cur_parent.find(".content-"+cur_index).addClass("active");
   }).mouseleave(function(){
     
   })

 })**/

 document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.nav-rows-new li').forEach(function(item) {
    item.addEventListener('mouseenter', function() {
      var curParent = this.closest('.new-mega-menu-container');
      curParent.querySelectorAll('.nav-rows-new li').forEach(function(li) {
        li.classList.remove('active');
      });
      this.classList.add('active');
      var curIndex = this.dataset.index;
      curParent.querySelectorAll('.products-list .tab-content').forEach(function(content) {
        content.classList.remove('active');
      });
      curParent.querySelector('.content-' + curIndex).classList.add('active');
    });
  });
  // 2. 桌面端 (Desktop)：鼠标悬浮加载图片collin
document.querySelectorAll('.new-mega-menu-container').forEach(function(container) {
  var parentMenuItem = container.closest('.contains-children') || container;
  parentMenuItem.addEventListener('mouseenter', function() {
    var lazyImages = container.querySelectorAll('.mega-menu-lazy-img');
    lazyImages.forEach(function(img) {
      if (img.dataset.hoverImage) {
        img.src = img.dataset.hoverImage;
        img.removeAttribute('data-hover-image'); 
      }
    });
  }, { once: true }); 
});
  // 3. 新增 -> 移动端 (Mobile)：点击折叠菜单展开时加载图片
var mobileMenuLoaded = false;
  
  function loadMobileImages() {
    if (mobileMenuLoaded) return;
    mobileMenuLoaded = true;
    var mobileLazyImages = document.querySelectorAll('.mobile-menu-lazy-img');
    mobileLazyImages.forEach(function(img) {
      if (img.dataset.mobileImage) {
        img.src = img.dataset.mobileImage;
        img.removeAttribute('data-mobile-image'); 
      }
    });
  }
  var burgerBtn = document.querySelector('a.menu[href="#page-menu"]');
  if (burgerBtn) {
    burgerBtn.addEventListener('click', loadMobileImages);
  }
  document.addEventListener('click', function(e) {
    if (e.target.closest('.menu') || e.target.closest('#page-menu')) {
      loadMobileImages();
    }
  });

});
</script>

