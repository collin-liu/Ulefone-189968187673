{% schema %}
{
  "name": "Activity Small Banner",
  "tag": "section",
  "class": "responsive-image-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "url",
      "id": "link_desktop",
      "label": "Desktop Image Link"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "url",
      "id": "link_mobile",
      "label": "Mobile Image Link"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image Border Radius (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Activity Small Banner",
      "category": "."
    }
  ]
}
{% endschema %}

{% style %}
.responsive-image-wrapper {
  max-width: 100%;
  width: 100%;
  margin: 0 auto;
  aspect-ratio: var(--aspect-ratio-desktop);
  overflow: hidden;
}

@media (max-width: 768px) {
  .responsive-image-wrapper {
    aspect-ratio: var(--aspect-ratio-mobile);
   /** width: 90%;**/
  }
}

.responsive-image-wrapper picture,
.responsive-image-wrapper a {
  display: block;
  width: 100%;
  height: 100%;
}

.responsive-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  /**border-radius: {{ section.settings.border_radius }}px;**/
}

section#shopify-section-{{ section.id }} {
  background-color: #f5f5f5;
}
{% endstyle %}

{% assign desktop_ratio = section.settings.image_desktop.aspect_ratio | default: 1 %}
{% assign mobile_ratio = section.settings.image_mobile.aspect_ratio | default: desktop_ratio %}

<div 
  class="responsive-image-wrapper"
  style="
    --aspect-ratio-desktop: {{ desktop_ratio }};
    --aspect-ratio-mobile: {{ mobile_ratio }};
  "
>
  {% if section.settings.image_desktop %}
    <a href="{{ section.settings.link_desktop | default: '#' }}" aria-label="Banner Link" target="_blank">

      <picture>
        {% if section.settings.image_mobile %}
          <source 
            media="(max-width: 768px)" 
            srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
        {% endif %}

        <img 
          src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
          width="{{ section.settings.image_desktop.width }}"
          height="{{ section.settings.image_desktop.height }}"
          alt="Banner Image"
          {%- comment -%} 性能：只有放在页面第一个区块时才抢首屏；在首页它位于下方，原来的 eager + high 会和首屏 Banner 抢带宽 {%- endcomment -%}
          {% if section.index == 1 %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}
        >
      </picture>

    </a>
  {% endif %}
</div>