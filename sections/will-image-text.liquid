<link rel="stylesheet" href="{{ 'will-image-text.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'will-image-text.css' | asset_url | stylesheet_tag }}</noscript>

<div class="will-image-text-container wide-container">
  <div class="category-display-component">
    <div class="bichromatic-title-component">
      <div class="bichromatic-title-box">
            <h2>{{ section.settings.main_title }}</h2>
            <h3>{{ section.settings.main_sub_title }}</h3>
          
      </div>
    </div>
    <div class="banner-component category-intro-components category-intro-image-left">
      <div class="category-intro-content">
          <div class="wrap">
              <div class="category-intro-image-box">
                  <div class="js-category-image-show">
                      <img
                        src="{{ section.settings.main_banner_image | img_url: '1120x630', crop: 'center' }}"
                        srcset="
                          {{ section.settings.main_banner_image | img_url: '560x315', crop: 'center' }} 560w,
                          {{ section.settings.main_banner_image | img_url: '800x450', crop: 'center' }} 800w,
                          {{ section.settings.main_banner_image | img_url: '1120x630', crop: 'center' }} 1120w
                        "
                        sizes="(max-width: 991px) 100vw, (max-width: 1599px) calc(51vw + 100px), 1120px"
                        alt="{{ section.settings.main_banner_title }}"
                        title="{{ section.settings.main_banner_title }}"
                        class="lazy category-intro-image"
                        width="1120"
                        height="630"
                        loading="lazy"
                      >
                  </div>
                  
              </div>
              <div class="category-intro-text-box">
                  <div class="category-intro-text-wrap">
                      <div class="category-intro-text">{{ section.settings.main_banner_title }}</div>
                      <a href="{{ section.settings.banner_btn_link }}" data-mktname="{{ section.settings.main_banner_title }}" class="btn-ga-topdp btn btn-square">{{ section.settings.banner_btn_text }}</a>
                  </div>
              </div>
          </div>
      </div>
    </div>
  </div>

  <div class="products-display-component">
      <div class="products-display-box init-normal" style="height: 1055.65px;">

        {% for block in section.blocks %}
          {% if block.type == "left_main" %}
            <div class="card-box lf-card-box card-item">
                <a href="{{ block.settings.cta_link }}" class="card-img-box mb-show ga-pdp-link">
                  <img
                    class="card-img pc-mb show success-img"
                    alt="{{ block.settings.main_title }}"
                    src="{{ block.settings.main_image | img_url: '400x400', crop: 'center' }}"
                    srcset="
                      {{ block.settings.main_image | img_url: '237x237', crop: 'center' }} 237w,
                      {{ block.settings.main_image | img_url: '400x400', crop: 'center' }} 400w
                    "
                    sizes="237px"
                    width="237"
                    height="237"
                    loading="lazy"
                  >
                </a>
                <div class="card-info">
                  <a href="{{ block.settings.cta_link }}" class="ga-pdp-link">
                    <div class="card-title">{{ block.settings.main_title }}</div>
                  </a>
        
                    <ul class="card-selling-points">
                      {{ block.settings.selling_points }}
                    </ul>
                  <div class="card-btn-group">
                    <a title="Learn More" href="{{ block.settings.cta_link }}"
                       class="btn-square card-btn ga-pdp-link btn   btn--arrow btn--arrow-white">
                       {{ block.settings.button_label }}
                    </a>
                  </div>
              </div>
                <a href="{{ block.settings.cta_link }}" class="card-img-box pc-show ga-pdp-link">
                <img
                  class="card-img pc-mb show success-img"
                  alt="{{ block.settings.main_title }}"
                  src="{{ block.settings.main_image | img_url: '600x600', crop: 'center' }}"
                  srcset="
                    {{ block.settings.main_image | img_url: '300x300', crop: 'center' }} 300w,
                    {{ block.settings.main_image | img_url: '400x400', crop: 'center' }} 400w,
                    {{ block.settings.main_image | img_url: '600x600', crop: 'center' }} 600w
                  "
                  sizes="(max-width: 991px) 237px, (max-width: 1599px) calc(46vw - 12px), 600px"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              </a>
            </div>
          {% endif %}
        {% endfor %}
    
        <div class="card-box rg-card-box four-items">
          {% for block in section.blocks %}
             {% if block.type == "right_item" %}
                  <div class="rg-card-item card-item item-product normal-item">
                    <a href="{{ block.settings.cta_link }}" class="card-link ga-pdp-link" data-nameforga="products_display_{{ block.settings.main_title }}"
                       data-position="2">
                  <img
  class="card-img show success-img"
  alt="{{ block.settings.main_title }}"
  src="{{ block.settings.main_image | img_url: '300x300', crop: 'center' }}"
  srcset="
    {{ block.settings.main_image | img_url: '150x150', crop: 'center' }} 150w,
    {{ block.settings.main_image | img_url: '237x237', crop: 'center' }} 237w,
    {{ block.settings.main_image | img_url: '300x300', crop: 'center' }} 300w
  "
  sizes="(max-width: 991px) 237px, (max-width: 1599px) calc(27vw - 24px), 300px"
  width="300"
  height="300"
  style="max-height: 186px; object-fit: contain;"
  loading="lazy"
>
                    </a>
                    <div class="card-info">
                      <div class="info-top">
                        <a href="{{ block.settings.cta_link }}" class="ga-pdp-link" data-nameforga="products_display_{{ block.settings.main_title }}"
                           data-position="2">
                          <p class="card-title" style="height: 22px;">{{ block.settings.main_title }}</p>
                        </a>
            
                        <ul class="card-selling-points">
                          {{ block.settings.selling_points }}
                        </ul>
                      </div>
                      <div class="info-bottom">
                        <div class="card-btn-group" style="height: 40px;">
                          <a title="Learn More" href="{{ block.settings.cta_link }}"
                             class="card-btn ga-pdp-link btn-square btn btn--text  btn--arrow ">
                             {{ block.settings.button_label }}
                         </a>
                        </div>
                      </div>
                    </div>
                  </div>
             {% endif %}
          {% endfor %}
        </div>
      </div>    
  </div>
</div>

