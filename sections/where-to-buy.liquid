{%- comment -%}
  Where to Buy - grouped by region / country, with search.
  Performance: logos are small, lazy-loaded, fixed-size boxes (no layout shift); CSS scoped to this section; ~1KB vanilla JS;
  every store link rendered server-side (crawlable for SEO / GEO).
{%- endcomment -%}

{%- liquid
  assign country_keys = ''
  assign store_total = 0
  for block in section.blocks
    if block.type == 'store'
      assign store_total = store_total | plus: 1
      assign c = block.settings.country | strip
      assign wrapped = '|' | append: c | append: '|'
      unless country_keys contains wrapped
        assign country_keys = country_keys | append: wrapped
      endunless
    endif
  endfor
  assign country_list = country_keys | split: '|'
  assign country_total = 0
  for c in country_list
    if c != blank
      assign country_total = country_total | plus: 1
    endif
  endfor
-%}

<div class="wtb" id="wtb-{{ section.id }}">
  <div class="wtb__hero">
    <div class="wtb__wrap">
      <h1 class="wtb__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="wtb__lead">{{ section.settings.subheading | replace: '[COUNT]', country_total }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="wtb__wrap">
    <section class="wtb__block" aria-labelledby="wtb-online-{{ section.id }}">
      <h2 class="wtb__h2" id="wtb-online-{{ section.id }}">Shop online</h2>
      <div class="wtb__online">
        {%- if section.settings.official_url != blank -%}
          <a class="wtb__official" href="{{ section.settings.official_url }}" target="_blank" rel="noopener">
            {%- if section.settings.official_logo != blank or section.settings.official_logo_url != blank -%}
              <span class="wtb__official-logo">
                {%- if section.settings.official_logo != blank -%}
                  {{ section.settings.official_logo | image_url: width: 280 | image_tag: loading: 'lazy', widths: '140, 280', sizes: '140px', alt: '' }}
                {%- else -%}
                  {%- assign u = section.settings.official_logo_url | split: '?' | first -%}
                  <img src="{{ u }}?width=280" srcset="{{ u }}?width=140 140w, {{ u }}?width=280 280w" sizes="140px" width="140" height="40" loading="lazy" decoding="async" alt="">
                {%- endif -%}
              </span>
            {%- endif -%}
            <span class="wtb__official-name">Ulefone Official Store</span>
            <span class="wtb__official-text">{{ section.settings.official_text }}</span>
            <span class="wtb__btn">Visit Official Store</span>
          </a>
        {%- endif -%}
        <div class="wtb__amazon">
          <span class="wtb__eyebrow wtb__eyebrow--muted">Amazon storefronts</span>
          <ul class="wtb__amazon-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'amazon' -%}
                <li {{ block.shopify_attributes }}>
                  <a class="wtb__chip" href="{{ block.settings.url }}" target="_blank" rel="noopener">
                    <span class="wtb__chip-logo">
                      {%- if block.settings.logo != blank -%}
                        {{ block.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', widths: '140, 280', sizes: '140px', alt: '' }}
                      {%- elsif block.settings.logo_url != blank -%}
                        {%- assign u = block.settings.logo_url | split: '?' | first -%}
                        <img src="{{ u }}?width=280" srcset="{{ u }}?width=140 140w, {{ u }}?width=280 280w" sizes="140px" width="140" height="36" loading="lazy" decoding="async" alt="">
                      {%- endif -%}
                    </span>
                    <span class="wtb__chip-label">{{ block.settings.label }}<span aria-hidden="true">&#8599;</span></span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </section>

    <section class="wtb__block" aria-labelledby="wtb-local-{{ section.id }}">
      <div class="wtb__bar">
        <h2 class="wtb__h2" id="wtb-local-{{ section.id }}">Local stores &amp; retailers</h2>
        <p class="wtb__count" aria-live="polite" data-wtb-count>{{ store_total }} stores in {{ country_total }} countries</p>
      </div>

      <form class="wtb__search" role="search" onsubmit="return false" data-wtb-form>
        <label for="wtb-q-{{ section.id }}" class="visually-hidden">Search country or store</label>
        <svg class="wtb__search-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="wtb-q-{{ section.id }}" class="wtb__input" type="search" autocomplete="off" placeholder="{{ section.settings.search_placeholder | escape }}" data-wtb-q>
      </form>

      <div class="wtb__tabs" role="tablist" aria-label="Regions">
        <button type="button" class="wtb__tab is-active" role="tab" aria-selected="true" data-wtb-region="all">All regions</button>
        {%- assign regions = 'Europe|Americas|Middle East & Africa|Asia-Pacific' | split: '|' -%}
        {%- for r in regions -%}
          <button type="button" class="wtb__tab" role="tab" aria-selected="false" data-wtb-region="{{ r | handleize }}">{{ r }}</button>
        {%- endfor -%}
      </div>

      <div class="wtb__grid">
        {%- for c in country_list -%}
          {%- if c == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign region = ''
            assign flag = ''
            assign search = c | downcase
            for block in section.blocks
              if block.type == 'store'
                assign bc = block.settings.country | strip
                if bc == c
                  if region == blank
                    assign region = block.settings.region
                  endif
                  if flag == blank and block.settings.country_code != blank
                    assign flag = block.settings.country_code | downcase | strip
                  endif
                  assign search = search | append: ' ' | append: block.settings.name | downcase
                endif
              endif
            endfor
          -%}
          <article class="wtb__card" data-region="{{ region | handleize }}" data-search="{{ search | escape }}">
            <div class="wtb__card-head">
              <h3 class="wtb__country">
                {%- if flag != blank -%}
                  <img class="wtb__flag" src="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/flags/4x3/{{ flag }}.svg" width="28" height="21" loading="lazy" decoding="async" alt="">
                {%- endif -%}
                {{ c }}
              </h3>
              <span class="wtb__region">{{ region }}</span>
            </div>
            <ul class="wtb__stores" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'store' -%}
                  {%- assign bc = block.settings.country | strip -%}
                  {%- if bc == c -%}
                    <li {{ block.shopify_attributes }} data-name="{{ block.settings.name | downcase | escape }}">
                      <a class="wtb__store" href="{{ block.settings.url }}" target="_blank" rel="noopener">
                        <span class="wtb__logo">
                          {%- if block.settings.logo != blank -%}
                            {{ block.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', widths: '140, 280', sizes: '140px', alt: '' }}
                          {%- elsif block.settings.logo_url != blank -%}
                            {%- assign u = block.settings.logo_url | split: '?' | first -%}
                            <img src="{{ u }}?width=280" srcset="{{ u }}?width=140 140w, {{ u }}?width=280 280w" sizes="140px" width="140" height="40" loading="lazy" decoding="async" alt="">
                          {%- endif -%}
                        </span>
                        <span class="wtb__store-text">
                          <span class="wtb__store-name">{{ block.settings.name }}</span>
                          <span class="wtb__store-type">
                            {%- case block.settings.type -%}
                              {%- when 'local' -%}Ulefone local store
                              {%- when 'amazon' -%}Amazon
                              {%- else -%}Authorized retailer
                            {%- endcase -%}
                          </span>
                        </span>
                        <span class="wtb__arrow" aria-hidden="true">&#8599;</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </article>
        {%- endfor -%}
      </div>

      <div class="wtb__empty" data-wtb-empty hidden>
        <p class="wtb__empty-title">No store found for &ldquo;<span data-wtb-term></span>&rdquo;.</p>
        <p>Try the Ulefone Official Store, or <a href="{{ section.settings.contact_url | default: '/pages/contact-us' }}">contact us</a> and we will point you to the nearest seller.</p>
      </div>
    </section>
  </div>
</div>

<style>
  .wtb{--wtb-ink:#000;--wtb-text:#222;--wtb-muted:#5e5c5c;--wtb-line:#dfdfdf;--wtb-soft:#f5f5f5;color:var(--wtb-text);font-family:inherit}
  .wtb *,.wtb *::before,.wtb *::after{box-sizing:border-box}
  .wtb__wrap{max-width:1400px;margin:0 auto;padding:0 24px}
  .wtb__hero{background:var(--wtb-soft);padding:64px 0 56px}
  .wtb__title{font-size:48px;line-height:1.1;font-weight:400;color:var(--wtb-ink)}
  .wtb__lead{margin:0;max-width:720px;font-size:18px;line-height:1.55;color:var(--wtb-muted)}
  .wtb__search{position:relative;margin:0 0 16px;max-width:640px}
  .wtb__search-icon{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--wtb-muted);pointer-events:none}
  .wtb__input{width:100%;height:52px;padding:0 16px 0 46px;border:1px solid var(--wtb-line);border-radius:4px;background:#fff;color:var(--wtb-ink);font:inherit;font-size:16px}
  .wtb__input:focus{outline:2px solid var(--wtb-ink);outline-offset:1px}
  .wtb__block{padding:56px 0 0}
  .wtb__block:last-child{padding-bottom:80px}
  .wtb__h2{margin:0 0 20px;font-size:28px;line-height:1.2;font-weight:400;color:var(--wtb-ink)}
  .wtb__online{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
  .wtb__official{display:flex;flex-direction:column;gap:10px;padding:28px;border-radius:4px;background:var(--wtb-ink);color:#fff;text-decoration:none}
  .wtb__official:hover{color:#fff}
  .wtb__official-logo{display:block;width:140px;height:44px;padding:6px 10px;border-radius:4px;background:#ffd101;margin-bottom:6px}
  .wtb__eyebrow{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#fff}
  .wtb__eyebrow--muted{color:var(--wtb-muted)}
  .wtb__official-name{font-size:28px;line-height:1.15}
  .wtb__official-text{font-size:16px;line-height:1.5;color:#dcdcdc}
  .wtb__btn{align-self:flex-start;margin-top:8px;padding:12px 22px;border-radius:4px;background:#fff;color:var(--wtb-ink);font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .wtb__official:hover .wtb__btn{background:var(--wtb-soft)}
  .wtb__amazon{display:flex;flex-direction:column;gap:14px;padding:28px;border:1px solid var(--wtb-line);border-radius:4px}
  .wtb__amazon-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:8px;margin:0;padding:0;list-style:none}
  .wtb__chip{display:flex;flex-direction:column;align-items:stretch;gap:8px;padding:12px;border:1px solid var(--wtb-line);border-radius:4px;color:var(--wtb-ink);text-decoration:none;font-weight:600;font-size:14px}
  .wtb__chip-logo{display:block;height:36px}
  .wtb__chip-logo img,.wtb__logo img,.wtb__official-logo img{display:block;width:100%!important;height:100%!important;max-width:none;object-fit:contain;margin:0}
  .wtb__chip-label{display:flex;justify-content:space-between;gap:8px}
  .wtb__chip-label span{color:var(--wtb-muted)}
  .wtb__chip:hover{border-color:var(--wtb-ink)}
  .wtb__bar{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px}
  .wtb__bar .wtb__h2{margin-bottom:12px}
  .wtb__count{margin:0 0 12px;font-size:15px;color:var(--wtb-muted)}
  .wtb__tabs{display:flex;gap:4px;overflow-x:auto;border-bottom:1px solid var(--wtb-line);margin-bottom:24px;-webkit-overflow-scrolling:touch}
  .wtb__tab{flex:none;min-height:44px;padding:0 18px;border:0;background:none;font:inherit;font-size:16px;color:var(--wtb-muted);cursor:pointer;white-space:nowrap;box-shadow:none}
  .wtb__tab.is-active{color:var(--wtb-ink);font-weight:600;box-shadow:inset 0 -3px 0 var(--wtb-ink)}
  .wtb__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;align-items:start}
  .wtb__card{padding:20px;border:1px solid var(--wtb-line);border-radius:4px;background:#fff}
  .wtb__card[hidden]{display:none}
  .wtb__card-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:12px}
  .wtb__country{margin:0;display:flex;align-items:center;gap:10px;font-size:22px;line-height:1.2;font-weight:600;color:var(--wtb-ink)}
  .wtb .wtb__flag{flex:none;display:block;width:28px;height:21px;margin:0;border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.08);object-fit:cover}
  .wtb__region{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--wtb-muted);white-space:nowrap}
  .wtb__stores{display:flex;flex-direction:column;gap:6px;margin:0;padding:0;list-style:none}
  .wtb__stores li[hidden]{display:none}
  .wtb__logo{display:block;width:140px;height:40px;padding:4px 8px;border-radius:3px;background:#fff}
  .wtb__store{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:12px 40px 12px 12px;border-radius:4px;background:var(--wtb-soft);color:var(--wtb-ink);text-decoration:none}
  .wtb__store:hover{background:#ebebeb;color:var(--wtb-ink)}
  .wtb__store-text{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .wtb__store-name{font-weight:600;font-size:15px;overflow-wrap:anywhere}
  .wtb__arrow{position:absolute;top:12px;right:14px;line-height:1}
  .wtb__store-type{font-size:13px;color:var(--wtb-muted)}
  .wtb__arrow{color:var(--wtb-muted)}
  .wtb__empty{padding:32px;border:1px dashed var(--wtb-line);border-radius:4px;color:var(--wtb-muted)}
  .wtb__empty-title{margin:0 0 6px;font-size:18px;font-weight:600;color:var(--wtb-ink)}
  .wtb__empty p{margin:0}
  .wtb .visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  /* Theme resets: the site theme centers headings and zeroes their margins, so re-assert ours with higher specificity */
  .wtb .wtb__title,.wtb .wtb__h2,.wtb .wtb__country,.wtb .wtb__lead,.wtb .wtb__count,.wtb .wtb__empty-title{text-align:left;letter-spacing:normal;text-transform:none}
  .wtb .wtb__title{margin:0 0 12px}
  .wtb .wtb__h2{margin:0 0 20px}
  .wtb .wtb__bar .wtb__h2{margin-bottom:12px}
  .wtb .wtb__country{margin:0}
  .wtb .wtb__tab{text-align:center}
  /* Theme normalize sets input[type=search] to content-box, which pushed the box past the screen edge on mobile */
  .wtb .wtb__search{width:100%}
  .wtb .wtb__input{box-sizing:border-box;width:100%;max-width:100%;min-width:0;-webkit-appearance:none;appearance:none;text-overflow:ellipsis}
  .wtb .wtb__search-icon{width:18px;height:18px;left:18px;color:#929292;fill:none!important}
  .wtb .wtb__search-icon circle,.wtb .wtb__search-icon path{fill:none!important;stroke:currentColor!important}
  .wtb,.wtb .wtb__store,.wtb .wtb__chip,.wtb .wtb__card,.wtb .wtb__official{text-align:left}
  .wtb .wtb__store{align-items:flex-start}
  .wtb .wtb__logo,.wtb .wtb__chip-logo,.wtb .wtb__official-logo{margin-left:0;margin-right:0}
  @media (max-width:767px){
    .wtb__hero{padding:40px 0 36px}
    .wtb .wtb__title{font-size:34px}
    .wtb__lead{font-size:16px}
    .wtb__wrap{padding:0 16px}
  }
</style>

<script>
  (function () {
    var root = document.getElementById('wtb-{{ section.id }}');
    if (!root) return;
    var input = root.querySelector('[data-wtb-q]');
    var tabs = root.querySelectorAll('[data-wtb-region]');
    var cards = root.querySelectorAll('.wtb__card');
    var count = root.querySelector('[data-wtb-count]');
    var empty = root.querySelector('[data-wtb-empty]');
    var term = root.querySelector('[data-wtb-term]');
    var region = 'all';

    function apply() {
      var q = (input.value || '').trim().toLowerCase();
      var nStores = 0, nCountries = 0;
      cards.forEach(function (card) {
        var inRegion = region === 'all' || card.getAttribute('data-region') === region;
        var countryHit = !q || card.querySelector('.wtb__country').textContent.toLowerCase().indexOf(q) > -1;
        var visible = 0;
        card.querySelectorAll('li[data-name]').forEach(function (li) {
          var show = inRegion && (countryHit || li.textContent.toLowerCase().indexOf(q) > -1);
          li.hidden = !show;
          if (show) visible++;
        });
        card.hidden = visible === 0;
        if (visible) { nStores += visible; nCountries++; }
      });
      count.textContent = nStores + (nStores === 1 ? ' store' : ' stores') + ' in ' + nCountries + (nCountries === 1 ? ' country' : ' countries');
      empty.hidden = nCountries > 0;
      term.textContent = input.value;
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        region = tab.getAttribute('data-wtb-region');
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        apply();
      });
    });
    input.addEventListener('input', apply);
    // On mobile, pressing Search/Enter closes the keyboard and brings the first result into view
    var form = root.querySelector('[data-wtb-form]');
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      apply();
      input.blur();
      var first = root.querySelector('.wtb__card:not([hidden])') || empty;
      if (first && first.getBoundingClientRect().top > window.innerHeight * 0.6) first.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

{% schema %}
{
  "name": "Where to Buy",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where to Buy" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "[COUNT] is replaced with the number of countries.", "default": "Buy from the Ulefone Official Store, our Amazon storefronts, or authorized local stores and retailers in [COUNT] countries and regions." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search your country or a store, e.g. Germany, Amazon, alza" },
    { "type": "url", "id": "official_url", "label": "Official Store link" },
    { "type": "image_picker", "id": "official_logo", "label": "Official Store logo" },
    { "type": "text", "id": "official_logo_url", "label": "Official Store logo URL" },
    { "type": "textarea", "id": "official_text", "label": "Official Store text", "default": "The full lineup of phones, tablets, wearables and accessories, direct from Ulefone." },
    { "type": "url", "id": "contact_url", "label": "Contact link (no results)" }
  ],
  "blocks": [
    {
      "type": "amazon",
      "name": "Amazon storefront",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "US" },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Wide logo, about 4:1. Overrides Logo URL." },
        { "type": "text", "id": "logo_url", "label": "Logo URL", "info": "Shopify Files URL, e.g. https://cdn.shopify.com/s/files/.../logo.png" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { "type": "text", "id": "name", "label": "Store name" },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Wide logo, about 4:1. Shown at 140x40. Overrides Logo URL." },
        { "type": "text", "id": "logo_url", "label": "Logo URL", "info": "Shopify Files URL, e.g. https://cdn.shopify.com/s/files/.../logo.png" },
        { "type": "text", "id": "country", "label": "Country / region", "info": "Stores with the same country are grouped into one card." },
        { "type": "text", "id": "country_code", "label": "Country code (for flag)", "info": "2-letter ISO code, e.g. de, gb, us." },
        {
          "type": "select", "id": "region", "label": "Region", "default": "Europe",
          "options": [
            { "value": "Europe", "label": "Europe" },
            { "value": "Americas", "label": "Americas" },
            { "value": "Middle East & Africa", "label": "Middle East & Africa" },
            { "value": "Asia-Pacific", "label": "Asia-Pacific" }
          ]
        },
        {
          "type": "select", "id": "type", "label": "Store type", "default": "retailer",
          "options": [
            { "value": "local", "label": "Ulefone local store" },
            { "value": "retailer", "label": "Authorized retailer" },
            { "value": "amazon", "label": "Amazon" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Where to Buy" }]
}
{% endschema %}
