{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.js' | asset_url | script_tag }}

<style>
  .main-heading {
     text-align: center;
  font-size: 2rem;
  margin-bottom: 30px;
  font-weight: 700;
  }

  .customer-stories-wrapper {
    padding: 40px 20px;
  }

  .swiper {
    overflow: hidden;
    position: relative;
  }

  .swiper-slide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 40px; 
    padding: 20px;
  }

 /* .slide-image {
    flex: 1 1 50%;
    max-width: 600px;
    text-align: center;
  }*/

  .slide-image img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .slide-text {
    flex: 1 1 50%;
    max-width: 37vw;
    padding: 20px;
  }

  .slide-text h2 {
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 16px;
  }

.swiper-button-next,.swiper-button-prev {
    background-color: #ccc;
    opacity: .5;
}
  .swiper-button-prev:after  {
    content: "<";
    height: 3vw;
    width: 3vw;
    text-align: center;
    line-height: 3vw;
}
  .swiper-button-next:after {
    content: ">";
    height: 3vw;
    width: 3vw;
    text-align: center;
    line-height: 3vw;
  }
  .swiper-pagination-bullet {
    background: #888;
    opacity: 0.7;
  }
  .swiper-pagination-bullet-active {
    background: #000;
    opacity: 1;
  }

  .slide-text h2,
.slide-text h6 {
  text-align: left;
    font-weight: 600;
}
.slide-text p {
    margin: 0;
}
  
  @media (max-width: 768px) {
    .tners-section-title {
    text-align: center;
    font-size: 1.8rem;
    margin-bottom: 2vw;
    font-weight: 800;
}
    .slide-text h2, .slide-text h6 {
    text-align: center;
    }
    .main-heading {
      font-size: 1.5rem;
      margin-bottom: 20px;
    }

    .swiper-slide {
      flex-direction: column;
    }

    .slide-image,
    .slide-text {
      flex: 1 1 100%;
      max-width: 100%;
    }

    .slide-text {
      text-align: center;
    }

    .slide-text h2 {
      font-size: 22px;
    margin: 1vw 0;
}
    .slide-text p {
      font-size: 14px;
      line-height: 1.2;
    }

      .swiper-button-prev:after  {
    content: "<";
    height: 9vw;
    width: 9vw;
    text-align: center;
    line-height: 9vw;
    font-size: 6vw;
}
  .swiper-button-next:after {
    content: ">";
    height: 9vw;
    width: 9vw;
    text-align: center;
    line-height: 9vw;
    font-size: 6vw;
  }
    .hero-content {
    text-align: center;
}
    .hero-content h3 {
    text-align: center;
    }
    
      .main-heading p {
       font-size: 1.8rem;
        line-height: 0;
        font-weight: 800;
      }
    .swiper-slide {
      gap: 0;
      padding: 0;
}
    .slide-text {
    padding: 10px 0;
}
  }
  @media (max-width: 480px) {
    
  }
</style>

<div class="customer-stories-wrapper page-width">
  {% if section.settings.main_heading != blank %}
    <h2 class="main-heading tners-section-title">
      {{ section.settings.main_heading }}
    </h2>
  {% endif %}

  <div class="swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="slide-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.caption | escape }}" loading="lazy" />
            {% endif %}
          </div>
          <div class="slide-text">
            {% if block.settings.custom_html != blank %}
              {{ block.settings.custom_html }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Swiper Pagination and Arrows -->
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.swiper', {
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
      },
      grabCursor: true
    });
  });
</script>

{% schema %}
{
  "name": "Customer Stories Slider",
  "settings": [
    {
      "type": "richtext",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "<h2>填吧</h2>"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "html",
          "id": "custom_html",
          "label": "Slide Caption"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Customer Stories Slider",
      "category": "Custom",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "custom_html": "<p>This is a customer story</p>",
            "image": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}