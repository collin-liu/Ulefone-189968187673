n                tt._hideTimeout = null;\n            }, ANIM_MS);\n        }\n        function cancelHide(tt) {\n            if (tt._hideTimeout) {\n                clearTimeout(tt._hideTimeout);\n                tt._hideTimeout = null;\n            }\n        }\n\n        function positionTooltip(trigger, tooltip) {\n            tooltip.style.display = 'block';\n            tooltip.classList.remove('top');\n\n            const rect = trigger.getBoundingClientRect();\n            const scrollTop = window.scrollY || document.documentElement.scrollTop;\n            const scrollLeft = window.scrollX || document.documentElement.scrollLeft;\n            const tooltipHeight = tooltip.offsetHeight || 120;\n            const tooltipWidth = tooltip.offsetWidth || 200;\n            const spaceBelow = window.innerHeight - rect.bottom;\n            const spaceAbove = rect.top;\n\n            if (spaceBelow < tooltipHeight && spaceAbove > tooltipHeight) {\n                tooltip.style.top = rect.top + scrollTop - tooltipHeight - 10 + 'px';\n                tooltip.classList.add('top');\n            } else {\n                tooltip.style.top = rect.bottom + scrollTop + 'px';\n                tooltip.classList.remove('top');\n            }\n\n            let leftPos = rect.left + scrollLeft;\n            if (leftPos + tooltipWidth > window.innerWidth - 10) {\n                leftPos = window.innerWidth - tooltipWidth - 10;\n            }\n            if (leftPos < 10) leftPos = 10;\n            tooltip.style.left = leftPos + 'px';\n        }\n\n        triggers.forEach(trigger => {\n            trigger.addEventListener('click', function (e) {\n                e.stopPropagation();\n                const id = this.getAttribute('data-tooltip');\n                const tooltip = document.getElementById(id);\n                if (!tooltip) return;\n                if (tooltip.classList.contains('show')) {\n                    scheduleHide(tooltip);\n                    return;\n                }\n                tooltips.forEach(t => {\n                    if (t !== tooltip && t.classList.contains('show')) scheduleHide(t);\n                });\n                cancelHide(tooltip);\n                positionTooltip(this, tooltip);\n                requestAnimationFrame(() => tooltip.classList.add('show'));\n            });\n        });\n        tooltips.forEach(t => {\n            const closeBtn = t.querySelector('.close-btn');\n            if (closeBtn) {\n                closeBtn.addEventListener('click', function (e) {\n                    e.stopPropagation();\n                    scheduleHide(t);\n                });\n            }\n        });\n        window.addEventListener('click', function (e) {\n            tooltips.forEach(t => {\n                if (!t.contains(e.target) && !triggers.some(btn => btn.contains(e.target))) {\n                    if (t.classList.contains('show')) scheduleHide(t);\n                }\n            });\n        });\n        function updateOpenTooltipsPosition() {\n            tooltips.forEach(t => {\n                if (!t.classList.contains('show')) return;\n                const trig = document.querySelector('.openTooltip[data-tooltip=\"' + t.id + '\"]');\n                if (trig) positionTooltip(trig, t);\n            });\n        }\n        window.addEventListener('resize', updateOpenTooltipsPosition);\n        window.addEventListener('scroll', updateOpenTooltipsPosition, true);\n    });\n</script>-->"
