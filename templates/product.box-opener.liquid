
<style>
@font-face{font-family:MiSans-Semibold;src:url('https://cdn.shopify.com/s/files/1/0830/0573/5193/files/MiSans-Semibold.woff?v=1787910170')}
@font-face{font-family:MiSans-Medium;src:url('https://cdn.shopify.com/s/files/1/0830/0573/5193/files/MiSans-Medium.woff2?v=1787938227')}
@font-face{font-family:MiSans-Regular;src:url('https://cdn.shopify.com/s/files/1/0830/0573/5193/files/MiSans-Regular.woff2?v=1787938227')}
#speccontent{display:none}
.bo-page {--bo-accent: #F5A623;--bo-dark: #1a1a1a;--bo-body: #5a5a5a;--bo-beige: #F8EDE3;--bo-light: #FAFAFA;--bo-grey: #EDEDED;/* --bo-max: 1200px; */--bo-radius: 14px;color: var(--bo-dark);line-height: 1.6;overflow-x: hidden;}
.bo-page h1.bo-hero__title{font-family:MiSans-Semibold;font-weight:600}
.bo-page p{font-family:MiSans-Regular}
.bo-page *{box-sizing:border-box}
.bo-page img{display:block;width:100%;height:auto}
.bo-page picture {display: block;}
.bo-page ul{list-style:none}
.bo-wrap{max-width:var(--bo-max);margin:0 auto;padding:0 24px}
.bo-hero{position:relative}
.bo-hero__text{position:absolute;top:14%;left:0;right:0;z-index:2;text-align:center;padding:0 16px}
.bo-hero__title{font-size:clamp(24px,2.25vw,44px);font-weight:700;letter-spacing:.2px;line-height:1.25}
.bo-hero__sub{font-size:clamp(14px,2.28vw,31px);font-family:MiSans-Medium;font-weight:600;line-height:1.5;margin-top:.25em}
.bo-intro{background:var(--bo-beige);padding:52px 0 58px;text-align:center}
.bo-intro__lead{max-width:50vw;margin:0 auto;font-size:clamp(13px,2.02vw,22px);color:#4d4d4d;line-height:1.85}
.bo-h2{font-size:clamp(22px,1.95vw,36px);font-weight:700;margin-top:3vw}
.bo-intro__sub{font-size:clamp(15px,2.4vw,31px);font-weight:500;color:#2b2b2b;line-height:1.45;margin-top:10px}
.bo-uses{display:flex;flex-wrap:wrap;justify-content:center;gap:34px 30px;margin-top:4vw}
.bo-uses__item{width:calc(20% - 24px);max-width:258px}
.bo-uses__item img{border-radius:50%}
.bo-uses__cap{font-size:clamp(11px,.82vw,14px);color:#3d3d3d;line-height:1.5;margin-top:14px}
.bo-features{padding:60px 0 66px;max-width:63vw;margin:0 auto}
.bo-feature{display:flex;align-items:center;justify-content:space-between;gap:6%;margin-bottom:46px}
.bo-feature:last-child{margin-bottom:0}
.bo-feature--rev{flex-direction:row-reverse}
.bo-feature__txt{flex:0 0 42%}
.bo-feature__img{flex:0 0 52%}
.bo-feature__img img{border-radius:var(--bo-radius)}
.bo-feature__title{font-size:clamp(18px,1.5vw,28px);font-weight:700;line-height:1.3;text-align:left}
.bo-feature__desc{font-size:clamp(12px,1.2vw,20px);color:var(--bo-body);line-height:1.75;margin-top:12px}
.bo-grip{position:relative;display:flex;flex-direction:column}
.bo-grip__txt{position:absolute;z-index:2;left:50%;top:25%;width:27%}
.bo-grip__title{font-size:clamp(17px,1.5vw,29px);font-weight:700;line-height:1.3;text-align:left}
.bo-grip__desc{font-size:clamp(11px,1.2vw,21px);color:#4d4d4d;line-height:1.75;margin-top:10px;text-align:left}
.bo-spec{background:var(--bo-grey);padding:56px 0 64px}
.bo-spec__inner{display:flex;align-items:center;justify-content:center;gap:9%}
.bo-spec__pic{flex:0 0 22%;max-width:240px}
.bo-spec__info{flex:0 0 42%}
.bo-spec__title{font-size:clamp(20px,1.85vw,34px);font-weight:700;margin-bottom:22px;text-align:left}
.bo-spec__item+.bo-spec__item{margin-top:22px}
.bo-spec__label{display:block;font-size:clamp(13px,1.05vw,18px);font-weight:500;color:#2b2b2b}
.bo-spec__val{display:block;font-size:clamp(18px,1.55vw,28px);font-weight:700;color:var(--bo-accent);line-height:1.35;margin-top:2px}
.bo-spec__val em{font-style:normal;font-size:.55em;font-weight:600;margin-left:2px}
@media (max-width:767px){
    .wide {width: 96%;}
    .bo-intro__lead {max-width: 88vw;}
    .bo-features {max-width: 98vw;}
    .bo-wrap{padding:0 18px}
    .bo-hero {flex-direction: column;margin-top: 7vw;}
    .bo-hero__text{padding:26px 18px 16px}
    .bo-hero__title{font-size:23px}
    .bo-hero__sub{font-size:14px}
    .bo-intro{padding:26px 0 30px}
    .bo-intro__lead{font-size:12.5px;line-height:1.8;padding:0 6px}
    .bo-h2{font-size:20px;margin-top:22px}
    .bo-intro__sub{font-size:15px;margin-top:8px}
    .bo-uses{gap:20px 14px;margin-top:22px}
    .bo-uses__item{width:calc(33.333% - 10px);max-width:none}
    .bo-uses__cap{font-size:11px;margin-top:9px}
    .bo-features{padding:30px 0 34px}
    .bo-feature,.bo-feature--rev{flex-direction:column;gap:0;margin-bottom:30px}
    .bo-feature__txt,.bo-feature__img{flex:0 0 auto;width:100%}
    .bo-feature__txt{text-align:center;margin-bottom:14px}
    .bo-feature__title{font-size:18px}
    .bo-feature__desc{font-size:12.5px;margin-top:8px;text-align:left;}
    .bo-grip{flex-direction:column-reverse;background:var(--bo-light)}
    .bo-grip__txt {left: 5vw;width: 75vw;top: 6vw;}
    .bo-grip__title{font-size:18px}
    .bo-grip__desc{font-size:12.5px;margin-top:8px}
    .bo-spec{padding:28px 0 34px}
    .bo-spec__inner{flex-direction:column;gap:18px}
    .bo-spec__pic{flex:0 0 auto;width:110px}
    .bo-spec__info{flex:0 0 auto;width:100%;text-align:center}
    .bo-spec__title{font-size:20px;margin-bottom:16px}
    .bo-spec__grid{display:flex;justify-content:center;gap:34px}
    .bo-spec__item{flex:0 0 auto;text-align:center}
    .bo-spec__item+.bo-spec__item{margin-top:0}
    .bo-spec__label{font-size:13px}
    .bo-spec__val{font-size:17px}}
@media (min-width:768px) and (max-width:1024px){
    .bo-intro{padding:38px 0 42px}
    .bo-features{padding:42px 0 46px}
    .bo-feature{margin-bottom:34px}
    .bo-uses{gap:24px 18px}
    .bo-spec{padding:40px 0 46px}
}
</style>

