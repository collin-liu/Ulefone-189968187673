<div id="featurescontent" class="bo-page">
    <section class="bo-hero">
        <div class="bo-hero__text">
            <h1 class="bo-hero__title">Box Opener</h1>
            <p class="bo-hero__sub">Mini Tape &amp; Envelope Cutter</p>
        </div>
        <picture class="bo-hero__pic">
            <source media="(max-width:767px)"
                    srcset="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-01.webp"
                    width="750" height="1000">
            <img class="bo-hero__img"
                 src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-1s.webp?v=1789867887"
                 alt="Ulefone Box Opener mini tape and envelope cutter slicing packing tape on a cardboard parcel"
                 width="2000" height="1125">
        </picture>
    </section>
    <section class="bo-intro">
        <div class="bo-wrap">
            <p class="bo-intro__lead">
                Quickly open letters, parcels, cartons, and delivery packages with ease.
                Keep it by your front door, in your bag, or attached to your keychain for
                instant access whenever a package arrives.
            </p>

            <h2 class="bo-h2">Multiple Cutting Functions</h2>
            <p class="bo-intro__sub">
                Designed for versatile everyday use,<br>this cutter easily handles:
            </p>

            <ul class="bo-uses">
                <li class="bo-uses__item">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-2-1.webp" alt="Opening envelopes and mail with the mini box opener" loading="lazy" width="335" height="335">
                    <p class="bo-uses__cap">Envelopes<br>and mail</p>
                </li>
                <li class="bo-uses__item">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-2-2.webp" alt="Cutting packing tape on a sealed cardboard box" loading="lazy" width="335" height="335">
                    <p class="bo-uses__cap">Cardboard boxes<br>sealed with<br>packing tape</p>
                </li>
                <li class="bo-uses__item">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-2-3.webp" alt="Slicing open a thick kraft paper envelope" loading="lazy" width="335" height="335">
                    <p class="bo-uses__cap">Thick paper<br>envelopes</p>
                </li>
                <li class="bo-uses__item">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-2-4.webp" alt="Cutting vinyl and plastic packaging tape" loading="lazy" width="335" height="335">
                    <p class="bo-uses__cap">Vinyl and<br>plastic tapes</p>
                </li>
                <li class="bo-uses__item">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-2-5.webp" alt="Cutting tag loops and packaging straps" loading="lazy" width="335" height="335">
                    <p class="bo-uses__cap">Tag loops and<br>packaging straps</p>
                </li>
            </ul>
        </div>
    </section>
    <section class="bo-features">
        <div class="bo-wrap">
            <div class="bo-feature">
                <div class="bo-feature__txt">
                    <h3 class="bo-feature__title">Compact &amp; Portable Design</h3>
                    <p class="bo-feature__desc">
                        The lightweight mini-sized body folds neatly for convenient storage and
                        transport. Easily attach it to a key ring, slip it into a pocket, or keep
                        it in a drawer without taking up space.
                    </p>
                </div>
                <div class="bo-feature__img">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-3-1.webp" alt="Compact box opener stored flat inside a wooden side table drawer" loading="lazy" width="942" height="520">
                </div>
            </div>
            <div class="bo-feature bo-feature--rev">
                <div class="bo-feature__txt">
                    <h3 class="bo-feature__title">Safe Retractable Blade</h3>
                    <p class="bo-feature__desc">
                        The blade retracts completely when not in use, reducing the risk of
                        accidental cuts and making it safe to carry in bags, pockets, or on a keychain.
                    </p>
                </div>
                <div class="bo-feature__img">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-3-2.webp" alt="Box opener with retracted blade being slipped into a jeans pocket" loading="lazy" width="942" height="520">
                </div>
            </div>
            <div class="bo-feature">
                <div class="bo-feature__txt">
                    <h3 class="bo-feature__title">Sharp &amp; Durable Steel Blade</h3>
                    <p class="bo-feature__desc">
                        Made from high-quality cutting steel, the blade delivers clean, precise cuts
                        and maintains its sharpness through repeated use.
                    </p>
                </div>
                <div class="bo-feature__img">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-3-3.webp" alt="Steel blade cutting a straight clean line through paper on a cutting mat" loading="lazy" width="942" height="520">
                </div>
            </div>
            <div class="bo-feature bo-feature--rev">
                <div class="bo-feature__txt">
                    <h3 class="bo-feature__title">Comfortable Ergonomic Grip</h3>
                    <p class="bo-feature__desc">
                        Constructed from durable PC (Polycarbonate) material, the body is designed
                        to fit comfortably in your hand, providing better control and reducing
                        effort during cutting tasks.
                    </p>
                </div>
                <div class="bo-feature__img">
                    <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-3-4.webp" alt="Hand holding the ergonomic box opener while opening a padded parcel" loading="lazy" width="942" height="520">
                </div>
            </div>

        </div>
    </section>
    <section class="bo-grip">
        <picture class="bo-hero__pic">
            <source media="(max-width:767px)"
                    srcset="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-04.webp"
                    width="750" height="1000">
            <img class="bo-hero__img"
                 src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-4.webp"
                 alt="Ulefone Box Opener mini tape and envelope cutter slicing packing tape on a cardboard parcel"
                 width="2000" height="1125">
        </picture>
        <div class="bo-grip__txt">
            <h3 class="bo-grip__title">Secure Anti-Slip Grip</h3>
            <p class="bo-grip__desc">
                Textured anti-slip dots on both sides provide a secure, comfortable grip,
                reducing hand slippage for safer, more precise cutting.
            </p>
        </div>
    </section>
    <section class="bo-spec">
        <div class="bo-wrap bo-spec__inner">
            <div class="bo-spec__pic">
                <img src="https://cdn.shopify.com/s/files/1/0830/0573/5193/files/box-opener-5-1.webp" alt="Ulefone Box Opener front view in black with yellow logo" loading="lazy" width="435" height="483">
            </div>
            <div class="bo-spec__info">
                <h2 class="bo-spec__title">Specifications:</h2>
                <div class="bo-spec__grid">
                    <div class="bo-spec__item">
                        <span class="bo-spec__label">Dimensions</span>
                        <span class="bo-spec__val">31 x 34 x 8.6 <em>mm</em></span>
                    </div>
                    <div class="bo-spec__item">
                        <span class="bo-spec__label">Material</span>
                        <span class="bo-spec__val">Body: PC</span>
                        <span class="bo-spec__val">Blade: Metal</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
