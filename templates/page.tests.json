n-5\">\n    <div class=\"dice-phone-wrapper pos-wrapper-5\">\n        <div class=\"video-mask\">\n            <video class=\"dice-video\" src=\"https://cdn.shopify.com/videos/c/o/v/59ff1373abf54d8ca321427ee9a8255f.mp4\" muted playsinline preload=\"auto\"></video>\n        </div>\n    </div>\n    <div class=\"video-control-btn pos-btn-5\">\n        <span class=\"btn-text\">REPLAY</span>\n    </div>\n</section>\n\n<section class=\"section section-6\"></section>\n\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        const videoSections = document.querySelectorAll('.section-3, .section-4, .section-5');\n        const observerOptions = { root: null, rootMargin: '0px', threshold: 0.5 };\n\n        videoSections.forEach(section => {\n            const video = section.querySelector('video');\n            const btn = section.querySelector('.video-control-btn');\n            if (!video || !btn) return;\n\n            const btnText = btn.querySelector('span');\n            let hasAutoPlayed = false;\n\n            btn.addEventListener('click', function () {\n                if (video.paused) {\n                    video.play();\n                    btnText.textContent = \"PAUSE\";\n                } else {\n                    video.pause();\n                    btnText.textContent = \"PLAY\";\n                }\n            });\n\n            video.addEventListener('ended', function () {\n                btnText.textContent = \"REPLAY\";\n            });\n\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        if (!hasAutoPlayed) {\n                            video.play().then(() => {\n                                hasAutoPlayed = true;\n                                btnText.textContent = \"PAUSE\";\n                            }).catch(error => { console.log(\"Autoplay prevented\", error); });\n                        }\n                    } else {\n                        if (!video.paused) {\n                            video.pause();\n                            btnText.textContent = \"PLAY\";\n                        }\n                    }\n                });\n            }, observerOptions);\n            observer.observe(video);\n        });\n    });\n</script>"
