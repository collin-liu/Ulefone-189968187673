            "image_position": "left"
          }
        },
        "tab_GHEM8x": {
          "type": "tab",
          "settings": {
            "tab_title": "App Management",
            "tab_content": "<p><strong>App<br/>Management<br/></strong>Deliver and manage Android and iOS applications in <br/>groups. Perform actions such as installation, <br/>removal, and update. Ensure compliance and <br/>streamline app management with Ulefone MDM's <br/>private app store, providing secure distribution and <br/>automated updates. Supports persistent application <br/>activity monitoring and custom system settings. <br/>With just a single click, transform any device into a <br/>dedicated enterprise tool.<br/><br/><br/></p>",
            "tab_image": "shopify://shop_images/mdm-2-2.webp",
            "image_position": "left"
          }
        },
        "tab_QNjgrx": {
          "type": "tab",
          "settings": {
            "tab_title": "Customized Device",
            "tab_content": "<p><strong>Customized<br/>Device<br/></strong>Easily customize devices with batch uploads of boot <br/>animations, wallpapers, and other device settings. <br/>Enhance your brand identity and boost user <br/>satisfaction with Ulefone MDM.<br/><br/><br/></p>",
            "tab_image": "shopify://shop_images/mdm-2-3.webp",
            "image_position": "left"
          }
        },
        "tab_BLbxmw": {
          "type": "tab",
          "settings": {
            "tab_title": "Remote Service",
            "tab_content": "<p><strong>Remote Service<br/></strong>Increase service efficiency with Ulefone MDM. Our <br/>remote viewing and device control features, along <br/>with OTA updates and log monitoring, streamline <br/>device management and reduce downtime.<br/><br/><br/></p>",
            "tab_image": "shopify://shop_images/mdm-2-4.webp",
            "image_position": "left"
          }
        },
        "tab_W3xExt": {
          "type": "tab",
          "settings": {
            "tab_title": "Kiosk Mode",
            "tab_content": "<p><strong>Kiosk Mode<br/></strong>We've designed our kiosk mode to help you <br/>customize devices for specific tasks. You can <br/>choose between single-app and multi-app modes. <br/>Plus, you can enhance device security and <br/>productivity with customizable system settings. <br/>Single-app mode is perfect for keeping employees <br/>focused on one task.</p>",
            "tab_image": "shopify://shop_images/mdm-2-5.webp",
            "image_position": "left"
          }
        },
        "tab_QcXtLT": {
          "type": "tab",
          "settings": {
            "tab_title": "Device Locking",
            "tab_content": "<p><strong>Device Locking<br/></strong>Our strong lock policy protects your device with <br/>secure lock screens and limits access to certain <br/>functions. Our flexible lock policy lets you control <br/>data access and app usage to keep your device <br/>secure and compliant.<br/><br/><br/></p>",
            "tab_image": "shopify://shop_images/mdm-2-6.webp",
            "image_position": "left"
          }
        },
        "tab_E7UKQd": {
          "type": "tab",
          "settings": {
            "tab_title": "Geofence & Alert",
            "tab_content": "<p><strong>Geofence & Alert<br/></strong>Monitor device location and usage. Receive <br/>notifications if devices go offline or leave <br/>designated areas. Enhance asset tracking and <br/>security with geofencing. Receive immediate <br/>notifications for lost or stolen devices.<br/><br/><br/></p>",
            "tab_image": "shopify://shop_images/mdm-2-7.webp",
            "image_position": "left"
          }
