: 3.1vw;\n    line-height: 1.5;\n}\n    }\n</style>\n\n<div class=\"section-7\">\n    <div class=\"solutions-container\">\n        <h2>Your All-in-One Solution for Device Management</h2>\n        <div class=\"solutions-grid\">\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-15.webp\" /></div>\n                <div class=\"solution-title\">Office Device Management</div>\n                <ul class=\"solution-features\">\n                    <li>Manage company phones/tablets to ensure  </li>\n                    <li>secure access to internal systems.</li>\n                </ul>\n            </div>\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-16.webp\" /></div>\n                <div class=\"solution-title\">Retail and Service Industries</div>\n                <ul class=\"solution-features\">\n                    <li>Manage in-store POS terminals and inventory scanners.</li>\n                    <li>Deploy apps and updates centrally.</li>\n                </ul>\n            </div>\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-17.webp\" /></div>\n                <div class=\"solution-title\">Education</div>\n                <ul class=\"solution-features\">\n                    <li>Manage school-issued tablets. Restrict students from</li>\n                    <li>installing games or accessing non-educational websites.</li>\n                </ul>\n            </div>\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-18.webp\" /></div>\n                <div class=\"solution-title\">Healthcare</div>\n                <ul class=\"solution-features\">\n                    <li>Ensure doctor tablets comply with HIPAA.</li>\n                    <li>Encrypt patient data and log access.</li>\n                </ul>\n            </div>\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-19.webp\" /></div>\n                <div class=\"solution-title\">Logistics and Transportation</div>\n                <ul class=\"solution-features\">\n                    <li>Track driver device location to optimize routes;</li>\n                    <li>remotely diagnose device issues.</li>\n                </ul>\n            </div>\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-20.webp\" /></div>\n                <div class=\"solution-title\">Remote/Hybrid Work</div>\n                <ul class=\"solution-features\">\n                    <li>When employees' personal phones access</li>\n                    <li>company email, MDM isolates work data and</li>\n                    <li>enforces two-factor authentication.</li>\n                </ul>\n            </div>\n            <div class=\"solution-card\">\n                <div class=\"solution-img\"><img src=\"https://cdn.shopify.com/s/files/1/0830/0573/5193/files/mdm-21.webp\" /></div>\n                <div class=\"solution-title\">Installment Retail</div>\n                <ul class=\"solution-features\">\n                    <li>Use MDM to manage regulations and usage</li>\n                    <li>restrictions for installment payment products,</li>\n                    <li>reducing risk.</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</div>"
