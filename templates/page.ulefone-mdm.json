        "custom_liquid": "<style>\n    .section-1 {background-color: #f6f6fb;}.section-1 h2 {font-weight: 600;font-size: 3vw;line-height: 1.2;}.section-1 p {font-size: 1vw;}\n    .section-1-text {width: 57vw;padding: 5vw 0;text-align: center;margin: 0 auto;}\n    @media (max-width: 992px) {\n    }\n    @media (max-width: 768px) {.section-1 h2 {font-size: 1.5rem;}.section-1 p {font-size: 3.1vw;line-height: 1.1;}.section-1-text {width: 86vw;padding: 12vw 0;text-align: center;margin: 0 auto;}\n    }\n</style>\n\n<section class=\"section section-1\">\n    <div class=\"section-1-text\">\n        <h2>What Is MDM</h2>\n        <p>\n            MDM uses software to centrally manage and secure company mobile devices (smartphones, tablets, laptops)\n            for security, compliance, and efficiency. It enables configuration, monitoring, maintenance, and remote\n            operation. Essential for mobile work, MDM balances efficiency, security, and cost across industries and is\n            increasingly vital with remote work and IoT.\n        </p>\n    </div>\n</section>"
