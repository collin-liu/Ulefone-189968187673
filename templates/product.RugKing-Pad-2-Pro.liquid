    <script>
        (function () {
            const carousel = document.getElementById('carousel');
            const slides = Array.from(carousel.children);
            const dots = Array.from(document.querySelectorAll('.dot'));
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const total = slides.length;
            let index = 0, autoTimer, pauseTimer, slideWidth = 0;
            const firstClone = slides[0].cloneNode(true);
            const lastClone = slides[slides.length - 1].cloneNode(true);
            firstClone.classList.add('clone');
            lastClone.classList.add('clone');
            carousel.insertBefore(lastClone, slides[0]);
            carousel.appendChild(firstClone);

            function updateSlideWidth() { slideWidth = carousel.clientWidth; }
            function updateDots() { dots.forEach((d, i) => d.classList.toggle('active', i === index)); }
            function jumpToReal(idx) { carousel.scrollTo({ left: slideWidth * (idx + 1), behavior: 'instant' }); }
            function scrollToIndex(idx, smooth = true) { carousel.scrollTo({ left: slideWidth * (idx + 1), behavior: smooth ? 'smooth' : 'instant' }); }

            function startAutoPlay() {
                clearInterval(autoTimer);
                autoTimer = setInterval(() => nextSlide(), 4000);
            }
            function resetAutoPlay() {
                clearInterval(autoTimer);
                clearTimeout(pauseTimer);
                pauseTimer = setTimeout(startAutoPlay, 6000);
            }

            function nextSlide() { index++; scrollToIndex(index); }
            function prevSlide() { index--; scrollToIndex(index); }

            function handleScrollEnd() {
                const maxScroll = slideWidth * (total + 1);
                if (carousel.scrollLeft >= maxScroll - slideWidth / 2) {
                    index = 0; jumpToReal(index);
                } else if (carousel.scrollLeft <= slideWidth / 2) {
                    index = total - 1; jumpToReal(index);
                } else {
                    index = Math.round(carousel.scrollLeft / slideWidth) - 1;
                }
                updateDots();
            }

            carousel.addEventListener('scroll', () => {
                clearTimeout(carousel._scrollTimer);
                carousel._scrollTimer = setTimeout(handleScrollEnd, 150);
            });

            nextBtn.addEventListener('click', () => { nextSlide(); resetAutoPlay(); });
            prevBtn.addEventListener('click', () => { prevSlide(); resetAutoPlay(); });
            dots.forEach(d => d.addEventListener('click', () => {
                index = Number(d.dataset.index);
                scrollToIndex(index);
                resetAutoPlay();
            }));
            carousel.addEventListener('touchstart', () => { clearInterval(autoTimer); });
            carousel.addEventListener('touchend', () => { resetAutoPlay(); });

            window.addEventListener('resize', () => {
                updateSlideWidth();
                jumpToReal(index);
            });

            updateSlideWidth();
            jumpToReal(0);
            updateDots();
            startAutoPlay();
        })();
    </script>
