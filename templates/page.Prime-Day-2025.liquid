<script>document.addEventListener('DOMContentLoaded', function () {
  var targetDate = new Date();
  targetDate.setMonth(6);
  targetDate.setDate(12);
  targetDate.setHours(15, 0, 0, 0);
  function padZero(num) {return num < 10 ? '0' + num : num;}
  function updateCountdown() {
    var now = new Date();
    var diff = targetDate - now;
    var countdown = document.getElementById('countdown');
    var blocks = countdown.querySelectorAll('.time-block');
    if (diff <= 0) {
      countdown.innerHTML =
        '<div class="time-block"><div class="number">00</div><div class="label">Sale</div></div>' +
        '<div class="time-block"><div class="number">00</div><div class="label">Ended</div></div>';
      clearInterval(timer);
      return;
    }
    var hours = Math.floor(diff / (1000 * 60 * 60));
    var minutes = Math.floor((diff / (1000 * 60)) % 60);
    var seconds = Math.floor((diff / 1000) % 60);
    if (blocks.length >= 3) {
      blocks[0].querySelector('.number').textContent = padZero(hours);
      blocks[1].querySelector('.number').textContent = padZero(minutes);
      blocks[2].querySelector('.number').textContent = padZero(seconds);
    }
  }
  updateCountdown();
  var timer = setInterval(updateCountdown, 1000);
});</script>