      }
      #page-menu .main-nav li{
        padding-left:4px;
      }
      .cc-accordion-item{
        border-bottom: 1px solid #ececec !important;
      }
        .theme-modal>.inner .growth-area .growth-area {
          padding: 0 4px;
        }
      .cc-accordion-item__title  {
          font-size: 14px;
          font-weight: 600;
